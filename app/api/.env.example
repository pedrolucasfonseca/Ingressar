# Ambiente de execução — habilita o cookie "secure" do refresh token quando "production".
NODE_ENV=development

# Porta em que a API escuta. Fallback: 3001.
PORT=3001

# String de conexão com o PostgreSQL.
# Em dev aponta para o container do docker-compose; em prod, para o banco do cluster.
DATABASE_URL=postgresql://user:password@localhost:5432/ticketing

# Segredos usados para assinar os tokens JWT — use valores diferentes para cada um. Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Duração do access token. Fallback: 15m.
JWT_EXPIRES_IN=15m