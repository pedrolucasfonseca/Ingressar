# Ambiente de execução — habilita o cookie "secure" do refresh token quando "production".
NODE_ENV=development

# Porta em que a API escuta. Fallback: 3001.
PORT=3001

# Origem do frontend — usado pelo CORS (credentials: true, obrigatório pro cookie
# httpOnly do refresh token funcionar cross-origin). Fallback: http://localhost:5173.
FRONTEND_URL=http://localhost:5173

# String de conexão com o PostgreSQL.
# Em dev aponta para o container do docker-compose; em prod, para o banco do cluster.
DATABASE_URL=postgresql://user:password@localhost:5432/ticketing

# Segredos usados para assinar os tokens JWT — use valores diferentes para cada um. Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Duração do access token. Fallback: 15m.
JWT_EXPIRES_IN=15m

# Chave secreta da Stripe (test mode) — pegue em https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Assinatura do webhook da Stripe — gerada pelo Stripe CLI (`stripe listen --forward-to localhost:3001/webhooks/stripe`) em dev
STRIPE_WEBHOOK_SECRET=

# Object Storage (S3-compatible) para upload de banner de evento — MinIO em dev (docker-compose), OCI Object Storage em prod
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=event-banners